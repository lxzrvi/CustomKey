        android:pathData="M55.0,45.6 A13,13 0 1 0 55.0,62.4"
        android:strokeColor="#000000"
        android:strokeLineCap="round"
        android:strokeWidth="5" />

    <!-- K stem -->
    <path
        android:pathData="M65,41.5 L65,66.5"
        android:strokeColor="#000000"
        android:strokeLineCap="round"
        android:strokeWidth="5" />

    <!-- K upper arm -->
